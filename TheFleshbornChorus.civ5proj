<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{20245136-80B0-4536-B83B-A112A667DB67}</ProjectGuid>
    <Name>The Fleshborn Chorus</Name>
    <SafeName>The Fleshborn Chorus</SafeName>
    <Guid>a4fd4238-1d64-4ab9-88bc-3aebf9f79150</Guid>
    <Teaser>Gold is inert. Iron is rock. The Chorus requires calories.</Teaser>
    <Description>A Community Patch civilization led by the First Maw. Divert Food into units, buildings, and colony buds while feeding an empire-wide biological army.</Description>
    <Authors>SolusGo</Authors>
    <SpecialThanks>Community Patch Project</SpecialThanks>
    <Homepage>https://github.com/SolusGo/TheFleshbornChorus</Homepage>
    <AssemblyName>TheFleshbornChorus</AssemblyName>
    <RootNamespace>TheFleshbornChorus</RootNamespace>
    <Civ5Path>G:\SteamLibrary\steamapps\common\Sid Meier's Civilization V</Civ5Path>
    <Civ5UserPath>C:\Users\ThatOneYi\Documents\My Games\Sid Meier's Civilization 5</Civ5UserPath>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>false</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>true</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>true</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <ModActions>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>SQL/00_Fleshborn_Core.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>SQL/10_Fleshborn_Text.sql</FileName>
      </Action>
    </ModActions>
    <ModContent>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Fleshborn Metabolism</Name>
        <Description>Runs growth projects, currency digestion, army feeding, terrain digestion, and AI support.</Description>
        <FileName>Lua/FleshbornCore.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Fleshborn Metabolism Panel</Name>
        <Description>Displays the active Chorus player's biological economy.</Description>
        <FileName>UI/FleshbornStatusPanel.xml</FileName>
      </Content>
    </ModContent>
    <ModVersion>1</ModVersion>
    <Stability>Alpha</Stability>
    <ModDependencies>
      <Association>
        <Type>Mod</Type>
        <Name>(1) Community Patch</Name>
        <Id>d1b6328c-ff44-4b0d-aad7-c657f83610cd</Id>
        <MinVersion>1</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
    </ModDependencies>
    <ModReferences />
    <ModBlockers />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="SQL\00_Fleshborn_Core.sql">
      <SubType>SQL</SubType>
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="SQL\10_Fleshborn_Text.sql">
      <SubType>SQL</SubType>
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="Lua\FleshbornCore.lua">
